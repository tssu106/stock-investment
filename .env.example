# === KTrader 환경변수 예시 ===
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요.

# Anthropic Claude API 키 (AI 분석에 필요, --mock 모드에서는 불필요)
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# DART 전자공시 OpenAPI 인증키 (공시/재무 데이터에 필요)
# https://opendart.fss.or.kr 에서 무료 발급
DART_API_KEY=

# (선택) 네이버 검색 OpenAPI - 뉴스 검색 보강용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (Phase 4, 실거래 단계에서만) 한국투자증권 KIS Developers
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
